---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout title="Pagina non trovata — SlotPieno" description="La pagina che cerchi non esiste. Torna alla home di SlotPieno.">
  <main class="container py-16 md:py-24 max-w-xl text-center">
    <h1 class="font-display font-bold text-6xl md:text-7xl text-stamp mb-4">404</h1>
    <p class="text-lg text-ink-muted mb-8">La pagina che cerchi non esiste o è stata spostata.</p>
    <a href="/" class="btn btn-primary inline-flex">Torna alla home</a>
    <p class="mt-6 text-sm text-ink-muted">Oppure <a href={`mailto:${siteConfig.email}`} class="underline hover:text-stamp">scrivici</a>, rispondiamo entro 24h.</p>
  </main>
</BaseLayout>
