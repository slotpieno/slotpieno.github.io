---
import WhatsApp from './icons/WhatsApp.astro';
import CalendarCheck from './icons/CalendarCheck.astro';
import ShieldCheck from './icons/ShieldCheck.astro';
import LockOpen from './icons/LockOpen.astro';

const features = [
  {
    icon: WhatsApp,
    title: 'Promemoria WhatsApp automatici',
    description: 'Messaggi personalizzati prima di ogni appuntamento. Il cliente conferma o sposta con un tap. Tu non alzi il telefono.',
    highlight: 'Meno dimenticanze, agenda piena.',
  },
  {
    icon: CalendarCheck,
    title: 'Conferma in 1 tap, niente rincorse',
    description: 'Il cliente riceve il messaggio, tocca "Confermo" o "Sposto". Vedi tutto in tempo reale. Zero chiamate, zero messaggi vocali.',
    highlight: 'Tu lavori, il sistema organizza.',
  },
  {
    icon: ShieldCheck,
    title: 'Zero software da imparare',
    description: 'Niente app complesse tipo Booksy o Fresha. Colleghiamo la tua agenda (Google Calendar, Calendly, iCal) e WhatsApp. Fatto.',
    highlight: 'Installazione done-for-you in 15 min.',
  },
  {
    icon: LockOpen,
    title: 'Nessun canone, nessun lock-in',
    description: 'Paghi il setup una volta: 149€. Se poi vuoi modifiche o supporto extra, ci sono pack a consumo. Mai un abbonamento obbligatorio.',
    highlight: 'Art. 67 TUIR — prestazione occasionale pura.',
  },
];
---

<section id="funzioni" class="section ruled" aria-labelledby="funzioni-title">
  <div class="container">
    <header class="text-center max-w-2xl mx-auto mb-16 reveal">
      <h2 id="funzioni-title" class="font-display font-bold text-4xl md:text-5xl text-ink text-balance">
        Tutto ciò che serve, niente di più
      </h2>
      <p class="mt-4 text-lg text-ink-muted text-balance">
        Quattro pilastri. Nessuna funzionalità superflua. Risolvi il problema no-show e torni a lavorare.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {features.map((f, i) => (
        <article class="card p-6 md:p-8 reveal" style={{ transitionDelay: `${100 + i * 100}ms` }}>
          <div class="w-12 h-12 rounded-lg bg-stamp/10 flex items-center justify-center text-stamp mb-4" aria-hidden="true">
            <f.icon />
          </div>
          <h3 class="font-display font-semibold text-xl text-ink mb-2">{f.title}</h3>
          <p class="text-ink-muted mb-4">{f.description}</p>
          <p class="text-sm font-medium text-sage">{f.highlight}</p>
        </article>
      ))}
    </div>
  </div>
</section>
