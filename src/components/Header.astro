---
import { siteConfig } from '../config/site';
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-sm" role="banner">
  <nav class="container flex items-center justify-between gap-4 py-3" aria-label="Navigazione principale">
    <a href="/" class="flex items-center gap-2 font-display font-bold text-xl text-ink" aria-label={`${siteConfig.name} — Home`}>
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="text-stamp">
        <rect x="2" y="6" width="24" height="16" rx="3" fill="currentColor" />
        <rect x="5" y="9" width="18" height="10" rx="2" fill="#faf7f0" />
        <circle cx="14" cy="14" r="4" fill="currentColor" />
        <rect x="10" y="12" width="8" height="1.5" rx="0.75" fill="#faf7f0" />
        <rect x="10" y="15.5" width="5" height="1" rx="0.5" fill="#faf7f0" />
      </svg>
      <span>{siteConfig.name}</span>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm text-ink-muted font-medium">
      <a class="hover:text-ink transition-colors" href="#funzioni">Funzioni</a>
      <a class="hover:text-ink transition-colors" href="#come-funziona">Come funziona</a>
      <a class="hover:text-ink transition-colors" href="#prezzo">Prezzo</a>
      <a class="hover:text-ink transition-colors" href="#faq">FAQ</a>
    </div>


    <details class="sm:hidden relative">
      <summary class="cursor-pointer list-none rounded border border-line px-3 py-2 text-sm text-ink" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded border border-line bg-paper p-2 text-sm shadow-lg">
        <a class="rounded px-2 py-2 hover:bg-stamp/10 transition-colors" href="#funzioni">Funzioni</a>
        <a class="rounded px-2 py-2 hover:bg-stamp/10 transition-colors" href="#come-funziona">Come funziona</a>
        <a class="rounded px-2 py-2 hover:bg-stamp/10 transition-colors" href="#prezzo">Prezzo</a>
        <a class="rounded px-2 py-2 hover:bg-stamp/10 transition-colors" href="#faq">FAQ</a>
      </div>
    </details>
  </nav>
</header>
