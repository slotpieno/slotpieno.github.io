---
import { siteConfig } from '../config/site';
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-brand-bg/85 backdrop-blur">
<nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3" aria-label="Navigazione principale">
<a href="/" class="flex items-center gap-2 font-bold text-lg"><span aria-hidden="true">📅</span> {siteConfig.name}</a>
<div class="hidden md:flex items-center gap-6 text-sm text-brand-muted">
<a class="hover:text-white" href="#funzioni">Funzioni</a>
<a class="hover:text-white" href="#come-funziona">Come funziona</a>
<a class="hover:text-white" href="#prezzo">Prezzo</a>
<a class="hover:text-white" href="#faq">FAQ</a>
</div>
<a href="#contatto" class="rounded-lg bg-brand-accent px-4 py-2 text-sm font-semibold text-white">Prova 14 giorni</a>
<details class="md:hidden relative">
<summary class="cursor-pointer list-none rounded-lg border border-white/15 px-3 py-2 text-sm">Menu</summary>
<div class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-lg border border-white/10 bg-brand-panel p-2 text-sm">
<a class="rounded px-2 py-2 hover:bg-white/5" href="#funzioni">Funzioni</a>
<a class="rounded px-2 py-2 hover:bg-white/5" href="#come-funziona">Come funziona</a>
<a class="rounded px-2 py-2 hover:bg-white/5" href="#prezzo">Prezzo</a>
<a class="rounded px-2 py-2 hover:bg-white/5" href="#faq">FAQ</a>
<a class="rounded px-2 py-2 hover:bg-white/5" href="#contatto">Contatto</a>
</div>
</details>
</nav>
</header>
