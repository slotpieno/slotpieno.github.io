---
import { siteConfig } from '../config/site';

const included = [
  'Installazione done-for-you (agenda + WhatsApp)',
  'Promemoria WhatsApp automatici illimitati',
  'Conferme e spostamenti in 1 tap',
  '30 giorni di assistenza prioritaria inclusa',
  'Nessun costo nascosto, nessun lock-in',
  'Pack supporto extra a consumo (es. 3 mesi 89€)',
];

const neverPay = [
  'Abbonamento mensile',
  'Commissioni a prenotazione',
  'Costi per messaggio',
  'Aggiornamenti obbligatori',
];
---

<section id="prezzo" class="section ruled" aria-labelledby="prezzo-title">
  <div class="container">
    <header class="text-center max-w-2xl mx-auto mb-12 reveal">
      <h2 id="prezzo-title" class="font-display font-bold text-4xl md:text-5xl text-ink text-balance">
        Un solo prezzo, chiaro
      </h2>
      <p class="mt-4 text-lg text-ink-muted text-balance">
        Niente piani, niente tier, niente sorprese. Una volta sola. Per sempre.
      </p>
    </header>

    <div class="mx-auto max-w-2xl">
      <article class="card p-8 md:p-10 relative overflow-hidden reveal" style="background: linear-gradient(145deg, var(--color-paper) 0%, var(--color-paper-dark) 100%);">
        <div class="absolute inset-0 bg-gradient-to-br from-stamp/5 via-transparent to-sage/5" aria-hidden="true"></div>

        <div class="relative text-center mb-10">
          <span class="inline-flex items-center gap-2 rounded-full border border-stamp/30 bg-stamp/10 px-4 py-1.5 text-sm font-medium text-stamp mb-4">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-stamp opacity-75"></span>
              <span class="relative inline-flex rounded-full bg-stamp"></span>
            </span>
            Offerta fondatore
          </span>
          <div class="font-display font-extrabold text-6xl md:text-7xl text-ink">
            <span class="text-stamp">{siteConfig.price.setup}</span>€
            <span class="font-normal text-2xl md:text-3xl font-sans text-ink-muted ml-2">una tantum</span>
          </div>
          <p class="mt-3 text-lg text-ink-muted">Prova gratuita {siteConfig.price.trialDays} giorni. Se non riduci i no-show, non paghi.</p>
        </div>

        <ul class="relative space-y-4 mb-10" role="list">
          {included.map((item, i) => (
            <li class="flex items-start gap-3 reveal" style={{ transitionDelay: `${100 + i * 80}ms` }}>
              <svg class="flex-shrink-0 mt-1 w-5 h-5 text-sage" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-lg text-ink/90">{item}</span>
            </li>
          ))}
        </ul>

        <div class="relative border-t border-paper-dark pt-6">
          <p class="text-sm text-ink-muted mb-4">Cosa <strong class="text-ink">NON</strong> paghi mai:</p>
          <div class="flex flex-wrap justify-center gap-3">
            {neverPay.map(item => (
              <span class="px-3 py-1.5 rounded-full border border-paper-dark/50 text-sm text-ink-muted">{item}</span>
            ))}
          </div>
        </div>

        <div class="relative mt-8 text-center">
          <a href="#contatto" class="btn btn-primary text-lg px-8 py-4 reveal" style="transition-delay: 600ms;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            Attiva la prova gratuita di {siteConfig.price.trialDays} giorni
          </a>
          <p class="mt-5 text-sm text-ink-muted">Se non riduci i no-show, non paghi il setup. Senza rischi.</p>
        </div>
      </article>
    </div>

    <div class="mt-12 text-center reveal" style="transition-delay: 700ms;">
      <p class="text-sm text-ink-muted">
        Domande sul prezzo? <a href={`mailto:${siteConfig.email}`} class="underline hover:text-stamp transition-colors">Scrivici</a>, rispondiamo entro 24h lavorative.
      </p>
    </div>
  </div>
</section>
