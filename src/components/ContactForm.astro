---
import { siteConfig } from '../config/site';
const placeholder = siteConfig.formspree.includes('XXXXXXXX');
---
<section id="contatto" class="mx-auto max-w-3xl px-4 py-10">
<h2 class="text-2xl md:text-3xl font-bold text-center">Richiedi la prova gratuita</h2>
<p class="mt-3 text-center text-sm text-brand-muted">Rispondiamo entro 24h lavorative a <a class="underline" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
{placeholder ? (
<p class="mx-auto mt-4 max-w-xl rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 text-sm" role="status">Modulo in configurazione: imposta l\u2019endpoint Formspree reale in <code>src/config/site.ts</code> (sostituire XXXXXXXX). Intanto scrivici via email.</p>
) : null}
<form method="POST" action={siteConfig.formspree} class="mx-auto mt-6 grid max-w-xl gap-4 rounded-2xl border border-white/10 bg-brand-panel p-6">
<label class="grid gap-1 text-sm">Nome e attività
<input required name="name" autocomplete="name" placeholder="Es. Maria — Parrucchiera a Roma" class="rounded-lg border border-white/15 bg-brand-bg px-3 py-2" />
</label>
<label class="grid gap-1 text-sm">Email
<input required type="email" name="email" autocomplete="email" placeholder="nome@esempio.it" class="rounded-lg border border-white/15 bg-brand-bg px-3 py-2" />
</label>
<label class="grid gap-1 text-sm">WhatsApp
<input required type="tel" name="phone" autocomplete="tel" placeholder="+39 ..." class="rounded-lg border border-white/15 bg-brand-bg px-3 py-2" />
</label>
<label class="grid gap-1 text-sm">Messaggio
<textarea name="message" rows={4} placeholder="Raccontaci come gestisci gli appuntamenti oggi" class="rounded-lg border border-white/15 bg-brand-bg px-3 py-2"></textarea>
</label>
<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
<label class="flex items-start gap-2 text-xs text-brand-muted">
<input required type="checkbox" name="privacy" class="mt-1" />
<span>Ho letto l\u2019<a class="underline" href="/privacy/">informativa privacy</a> e acconsento al contatto.</span>
</label>
<button type="submit" class="rounded-lg bg-brand-accent px-5 py-3 font-semibold text-white">Invia richiesta</button>
</form>
</section>
