---
import { siteConfig } from '../config/site';
---
<section id="contatto" class="mx-auto max-w-3xl px-4 py-10 text-center">
<h2 class="text-2xl md:text-3xl font-bold">Pronto a ridurre i no-show?</h2>
<p class="mt-3 text-brand-muted">Scrivici a <a class="underline" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> per la prova gratuita di {siteConfig.price.trialDays} giorni.</p>
<a href={`mailto:${siteConfig.email}?subject=Prova%20gratuita%20SlotPieno`} class="mt-6 inline-block rounded-lg bg-brand-accent px-6 py-3 font-semibold text-white">Richiedi la prova gratuita</a>
</section>
