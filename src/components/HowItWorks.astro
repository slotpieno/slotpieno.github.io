---
const steps = [
{ n: '1', t: 'Ci dici come lavori', d: 'Orari, servizi e regole di promemoria. 15 minuti al telefono.' },
{ n: '2', t: 'Installiamo tutto noi', d: 'Colleghiamo agenda e WhatsApp. Tu continui a lavorare.' },
{ n: '3', t: 'I clienti si presentano', d: 'Promemoria automatici, conferme e spostamenti gestiti.' },
];
---
<section id="come-funziona" class="mx-auto max-w-6xl px-4 py-10">
<h2 class="text-2xl md:text-3xl font-bold text-center">Come funziona</h2>
<ol class="mt-6 grid gap-4 grid-cols-1 md:grid-cols-3">
{steps.map((s) => (
<li class="rounded-xl border border-white/10 bg-brand-panel p-5">
<p class="text-3xl font-extrabold text-brand-accent">{s.n}</p>
<h3 class="mt-2 font-semibold">{s.t}</h3>
<p class="mt-2 text-sm text-brand-muted">{s.d}</p>
</li>
))}
</ol>
</section>
