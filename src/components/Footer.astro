---
import { siteConfig } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-paper-dark bg-paper" role="contentinfo">
  <div class="container py-10 md:py-16">
    <div class="grid gap-8 md:grid-cols-3 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2 font-display font-bold text-xl text-ink mb-4" aria-label={`${siteConfig.name} — Home`}>
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="text-stamp">
            <rect x="2" y="6" width="24" height="16" rx="3" fill="currentColor" />
            <rect x="5" y="9" width="18" height="10" rx="2" fill="#faf7f0" />
            <circle cx="14" cy="14" r="4" fill="currentColor" />
            <rect x="10" y="12" width="8" height="1.5" rx="0.75" fill="#faf7f0" />
            <rect x="10" y="15.5" width="5" height="1" rx="0.5" fill="#faf7f0" />
          </svg>
          <span>{siteConfig.name}</span>
        </a>
        <p class="text-ink-muted max-w-xs leading-relaxed">{siteConfig.tagline}. Promemoria WhatsApp automatici, installazione done-for-you, nessun canone mensile.</p>
      </div>

      <nav aria-label="Navigazione secondaria">
        <h3 class="font-semibold text-ink mb-4">Navigazione</h3>
        <ul class="space-y-2 text-sm" role="list">
          <li><a href="#funzioni" class="text-ink-muted hover:text-ink transition-colors">Funzioni</a></li>
          <li><a href="#come-funziona" class="text-ink-muted hover:text-ink transition-colors">Come funziona</a></li>
          <li><a href="#prezzo" class="text-ink-muted hover:text-ink transition-colors">Prezzo</a></li>
          <li><a href="#faq" class="text-ink-muted hover:text-ink transition-colors">FAQ</a></li>
          <li><a href="#contatto" class="text-ink-muted hover:text-ink transition-colors">Contatto</a></li>
        </ul>
      </nav>

      <nav aria-label="Contatti e legale">
        <h3 class="font-semibold text-ink mb-4">Contatti & Legale</h3>
        <ul class="space-y-2 text-sm" role="list">
          <li><a href={`mailto:${siteConfig.email}`} class="text-ink-muted hover:text-stamp transition-colors">{siteConfig.email}</a></li>
          <li><a href="/privacy/" class="text-ink-muted hover:text-ink transition-colors">Privacy</a></li>
          <li class="text-ink-muted">Risposta entro 24h lavorative</li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 pt-6 border-t border-paper-dark flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-ink-muted">© {year} {siteConfig.name} — Tutti i diritti riservati.</p>
      <p class="text-xs text-ink-muted">Servizio informativo, nessun pagamento online. Setup una tantum 149€, nessun canone. Art. 67 TUIR compliant.</p>
    </div>
  </div>
</footer>
